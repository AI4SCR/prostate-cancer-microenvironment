## Copy to `.env` and fill in machine-specific values. `.env` is gitignored.

# Root of the staged ai4bmr-datasets PCa layout (contains 01_raw/, 02_processed/).
BASE_DIR=/absolute/path/to/datasets/PCa

# Where figure scripts (Python and R) export/read intermediate parquet tables
# (metadata.parquet, intensity_normalized.parquet, clinical.parquet, scores*.parquet).
# Defaults to BASE_DIR/0-export if unset.
EXPORT_DIR=${BASE_DIR}/0-export

# Only needed to run scripts/upload-data-to-zenodo.py.
ZENODO_API_KEY=
