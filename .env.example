## Copy to `.env` and fill in machine-specific values. `.env` is gitignored.

# Root of the staged ai4bmr-datasets PCa layout (contains 01_raw/, 02_processed/).
# READ-ONLY: no script in this repo may ever write here.
BASE_DIR=/absolute/path/to/datasets/PCa

# Where figure scripts (Python and R) write/read intermediate parquet tables
# (metadata.parquet, intensity_normalized.parquet, clinical.parquet, scores*.parquet)
# and generated figures. Must be outside BASE_DIR -- resolve_export_dir() /
# assert_outside_base_dir() in src/prostate_cancer/utils.py enforce this at
# runtime regardless of what's set here. Point this at a path inside this repo
# (e.g. its default, below) so everything generated is easy to find and delete.
EXPORT_DIR=/absolute/path/to/prostate-cancer-microenvironment/data/0-export

# Only needed to run scripts/upload-data-to-zenodo.py.
ZENODO_API_KEY=
