## Copy to `.env` and fill in machine-specific values. `.env` is gitignored.

# Root of the staged ai4bmr-datasets PCa layout (contains 01_raw/, 02_processed/).
# READ-ONLY: no script in this repo may ever write here.
BASE_DIR=/absolute/path/to/datasets/PCa

# Where figure scripts (Python and R) write/read intermediate parquet tables
# (metadata.parquet, intensity_normalized.parquet, clinical.parquet,
# scores*.parquet) and cached data (e.g. UMAP embeddings). Must be outside
# BASE_DIR -- resolve_export_dir() / assert_outside_base_dir() in
# src/prostate_cancer/utils.py enforce this at runtime regardless of what's
# set here. Point this at a path inside this repo (e.g. its default, below)
# so everything generated is easy to find and delete.
EXPORT_DIR=/absolute/path/to/prostate-cancer-microenvironment/data

# Where figure scripts write generated plots (PDFs/PNGs/CSVs) -- kept
# separate from EXPORT_DIR so deliverables aren't mixed in with intermediate
# data tables/caches.
OUTPUT_FIGURES_DIR=/absolute/path/to/prostate-cancer-microenvironment/output/figures

# Only needed to run scripts/upload-data-to-zenodo.py.
ZENODO_API_KEY=

# Consolidated, read-only copy of legacy pre-migration data that has no
# reproducing script in this repo (niche-neighborhood raw data, the
# PCA_NHOODs_clean code these figure scripts import, colormaps.yaml). Do NOT
# use this for metadata/clinical/intensity(_normalized).parquet -- those are
# reproducible via export_for_r.py and come from $EXPORT_DIR instead. See
# REPRODUCIBILITY.md and figure_script_mapping.md.
LEGACY_DATA_DIR=/work/FAC/FBM/DBC/mrapsoma/prometex/data/prostate-cancer-microenvironment
