## Copy to `.env` and fill in machine-specific values. `.env` is gitignored.

# Root of the staged ai4bmr-datasets PCa layout (contains 01_raw/, 02_processed/).
# READ-ONLY: no script in this repo may ever write here.
BASE_DIR=/absolute/path/to/datasets/PCa

# Every input a figure script reads, and everywhere export.py writes its
# generated tables. Holds both reproducible exports (cells/, clinical.parquet)
# and staged legacy tables with no reproducing script in this repo (niches/,
# neighborhoods/, umap/, niches/robustness/ code) side by side -- see
# data/assets.md for the per-file provenance. Must be outside BASE_DIR --
# resolve_data_dir() / assert_outside_base_dir() in src/prostate_cancer/utils.py
# enforce this at runtime regardless of what's set here. Point this at a path
# inside this repo (e.g. its default, below) so the repo is self-contained.
DATA_DIR=/absolute/path/to/prostate-cancer-microenvironment/data

# Where figure scripts write generated plots (PDFs/PNGs/CSVs) -- kept
# separate from DATA_DIR so deliverables aren't mixed in with input data.
OUTPUT_FIGURES_DIR=/absolute/path/to/prostate-cancer-microenvironment/output/figures

# Only needed to run scripts/upload-data-to-zenodo.py.
ZENODO_API_KEY=
